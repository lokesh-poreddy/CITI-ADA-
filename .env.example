# Safe defaults only. Never place real tokens/secrets in this file.
VITE_PLATFORM_API_BASE_URL=http://localhost:8080/api/v1
VITE_AI_SERVICE_BASE_URL=http://localhost:8000/api/v1
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AI_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SERVER_PORT=8080
AI_PORT=8000

# Opportunity reviewer endpoint: prototype only. Set a strong value locally; do not commit secrets.
APP_REVIEWER_TOKEN=
# Generate a local value with: openssl rand -hex 32. Leave blank to keep admin reporting disabled.
# Optional grounded generation. Safe default is retrieval-only (no external model calls).
AI_PROVIDER=none
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# Local Docker demo database only. Replace with a strong secret; never reuse this example password.
POSTGRES_DB=udaansetu
POSTGRES_USER=udaansetu
POSTGRES_PASSWORD=replace-with-a-long-random-local-demo-password
# Set false only when a real identity provider + RBAC layer has been configured.
APP_PROTOTYPE_IDENTITIES_ENABLED=true
